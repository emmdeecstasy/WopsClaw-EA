# Perisclaw TG Environment Variables
# Copy to .env and fill in your values

# Required
BOT_TOKEN=your_telegram_bot_token_here  # Get from @BotFather on Telegram

# Optional cloud sync (all opt-in, default: local-only)
# Supabase PostgreSQL (500MB free tier)
# SUPABASE_URL=https://your-project.supabase.io
# SUPABASE_ANON_KEY=your-anon-key-from-supabase
# USE_SUPABASE=false  # Set to true to enable Supabase cloud sync

# Turso Offline-first LibSQL (1GB free tier)
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# USE_TURSO=false  # Set to true to enable Turso offline sync

# Privacy
ENCRYPTION_KEY=random-32-byte-key-here  # Generated automatically if empty

# Server
PORT=3000
NODE_ENV=development